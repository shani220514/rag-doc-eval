# Live retrieve only. Fixture / pytest never needs these.
# Copy to .env (gitignored). Shell env wins over .env.
# dry-run sync does not require any of these keys.

# Retrieve HTTP (DashScope-compatible JSON). Leave blank for fixture mode.
RETRIEVE_API_KEY=
RETRIEVE_WORKSPACE_ID=
RETRIEVE_INDEX_ID=
# Optional override; default is DashScope retrieve endpoint.
RETRIEVE_URL=

# Live document upsert (not implemented in v1; missing keys exit 2, no network).
RETRIEVE_ACCESS_KEY_ID=
RETRIEVE_ACCESS_KEY_SECRET=
